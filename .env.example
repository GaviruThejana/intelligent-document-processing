# Copy to .env (never commit .env). docker compose reads this file automatically.
POSTGRES_USER=idp
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=idp

# Browser-visible API URL (baked into the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

MAX_UPLOAD_MB=10
OCR_MIN_CONFIDENCE=60
FIELD_MIN_CONFIDENCE=70

# Optional: enables the AI extractor as the PRIMARY extractor (rule-based extractor remains the fallback).
# Leave empty to run fully offline with Tesseract + rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
